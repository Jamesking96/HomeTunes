<?xml version="1.0" encoding="utf-8"?>
<!-- HomeTunes' opening screen (0.2.13), as drawable/launch_background.xml: the user's picture on
     its edge colour, filling a TV's screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item android:width="960dp" android:height="540dp" android:gravity="center"
        android:drawable="@drawable/launch_splash" />
</layer-list>
