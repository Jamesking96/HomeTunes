<?xml version="1.0" encoding="utf-8"?>
<!-- HomeTunes' opening screen (0.2.13) on a phone held upright: the user's 16:9 picture across
     the screen's width (360 dp, about a phone's), in the middle, on its edge colour. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item android:width="360dp" android:height="203dp" android:gravity="center"
        android:drawable="@drawable/launch_splash" />
</layer-list>
