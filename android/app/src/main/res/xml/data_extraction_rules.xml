<?xml version="1.0" encoding="utf-8"?>
<!-- HomeTunes (0.1.21, security review #5): nothing is copied to Google's cloud backup or to a
     new phone during setup. Moving to a new phone uses a HomeTunes backup (.htbackup) instead.
     Android 12 and later read this file; older versions follow allowBackup="false". -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
