<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- HomeTunes (0.2.12): dark whatever the device's dark mode, because the app is dark. Before,
         this was Flutter's template: a white window while HomeTunes started (white on the TV,
         whose dark mode is off). -->
    <!-- Shown while the process starts: the dark background with the icon in the middle. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind Flutter once it's running, and while it draws its first picture. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
