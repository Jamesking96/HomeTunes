<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- HomeTunes (0.2.12), Android 12 and later: Android draws its own opening screen first (the
         app's icon on a background). Here it's HomeTunes' dark background, so it matches the
         launch window and the app after it (the test TV runs Android 12). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <!-- 0.2.13: no icon (drawable/splash_blank.xml): the picture HomeTunes shows next has its own. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
