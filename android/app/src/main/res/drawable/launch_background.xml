<?xml version="1.0" encoding="utf-8"?>
<!-- HomeTunes' opening screen (0.2.12): the app's dark background with its icon in the middle,
     shown by Android while HomeTunes starts. Before, Flutter's template left it white (the user,
     8 Nov 2026: "update the TV build so that the opening screen isn't just a white screen").
     lib/ui/start_screen.dart draws the same picture once Flutter is running, so the two meet
     without a jump. launch_logo.png is the 192-pixel app icon; in drawable-xhdpi it's 96 dp. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
